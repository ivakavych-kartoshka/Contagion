# ============================================================
#  FILE CẤU HÌNH KEY — DÁN KEY CỦA BẠN VÀO ĐÂY (file .env)
# ============================================================
#  Cách dùng:
#    1. Copy file này thành  ".env"  (bỏ chữ .example)
#       PowerShell:  Copy-Item .env.example .env
#    2. Mở .env bằng Notepad, dán key vào sau dấu =
#    3. Lưu lại. Xong — các script tự đọc file này.
#
#  ⚠️ File .env KHÔNG được commit lên git (đã có trong .gitignore).
#     Không dán key vào chat / không gửi qua mạng.
# ============================================================

# --- Amazon Bedrock (key dạng bedrock-api-key-...) ---
AWS_BEARER_TOKEN_BEDROCK=
# Region Bedrock (mặc định us-east-1; script test_bedrock.py tự dò nếu sai)
AWS_DEFAULT_REGION=us-east-1

# --- (Tùy chọn) OpenRouter nếu dùng thay Bedrock ---
OPENROUTER_API_KEY=

# --- (Tùy chọn) OpenAI-compatible endpoint khác (vLLM / DeepSeek / ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
